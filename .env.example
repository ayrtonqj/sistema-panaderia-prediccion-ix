# === Email (Gmail SMTP para alertas y notificaciones) ===
SMTP_EMAIL=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
ADMIN_EMAIL=admin_correo@gmail.com

# === Notificaciones ===
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contraseña_de_aplicacion

# === URL Base del Backend FastAPI ===
VITE_API_URL=http://localhost:8000

# === Modo Demo (Auto-login automático para despliegues públicos) ===
# Establecer a 'true' para despliegues públicos en Render, Vercel, etc.
VITE_DEMO_MODE=true

# Credenciales para el Modo Demo (por defecto 'admin' / 'admin')
VITE_DEMO_USERNAME=admin
VITE_DEMO_PASSWORD=admin
