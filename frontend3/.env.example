# URL Base del backend FastAPI
VITE_API_URL=http://localhost:8000

# Activar Modo Demo (Auto-login automático sin ingresar credenciales)
# Establecer a 'true' para despliegues públicos en Render, Vercel, Netlify, etc.
VITE_DEMO_MODE=true

# Credenciales para el Modo Demo (Opcional, por defecto usa 'admin' / 'admin')
VITE_DEMO_USERNAME=admin
VITE_DEMO_PASSWORD=admin
